// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Schema for a User
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  roles     Role[]   @default([USER])

  notes          Notes[]
  workout        Workout[]
  workoutProgram WorkoutProgram[]
  exercises      Exercise[]
  sessions       WorkoutSession[]
}

// Schema for written notes in a workout or workout cycle
model Notes {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String?
  note      String?
  createdAt DateTime @default(now())

  workoutId         Int?
  workout           Workout?
  workoutProgramId  Int?
  workoutProgram    WorkoutProgram?
  workoutExerciseId Int?
  workoutExercise   WorkoutExercise?
  user              User             @relation(fields: [userId], references: [id])
}

// Schema for a workout plan 
model Workout {
  id               Int      @id @default(autoincrement())
  userId           Int
  title            String
  description      String   @default("")
  code             String   @unique
  createdAt        DateTime @default(now())
  noteId           Int?     @unique
  workoutProgramId Int?

  note             Notes?            @relation(fields: [noteId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  workoutExercises WorkoutExercise[]
  workoutProgram   WorkoutProgram?   @relation(fields: [workoutProgramId], references: [id], onDelete: SetNull)
  sessions         WorkoutSession[]
}

model WorkoutProgram {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String   @default("")
  createdAt   DateTime @default(now())
  noteId      Int?     @unique

  note     Notes?    @relation(fields: [noteId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  workouts Workout[]
}

// Target for one set of a planned exercise: a rep range and an optional weight
model PlannedSet {
  id      Int    @id @default(autoincrement())
  order   Int
  repsMin Int
  repsMax Int // equal to repsMin for a fixed rep target
  weight  Float?

  workoutExerciseId Int
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
}

// Schema for a Exercise: global catalog (userId null) or a user's custom exercise
model Exercise {
  id          Int    @id @default(autoincrement())
  name        String
  description String @default("")
  userId      Int?
  user        User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  workoutExercises WorkoutExercise[]
  sessionExercises SessionExercise[]

  // NULL userIds are distinct in Postgres: ExerciseService.create checks global names itself
  @@unique([name, userId])
}

// An exercise planned in a workout template
model WorkoutExercise {
  id    Int @id @default(autoincrement())
  order Int @default(0)

  exerciseId Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  plannedSets PlannedSet[]
  restTime    String?
  createdAt   DateTime     @default(now())

  noteId    Int?    @unique
  note      Notes?  @relation(fields: [noteId], references: [id])
  workoutId Int
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  sessionExercises SessionExercise[]
}

// One performed workout, optionally started from a template
model WorkoutSession {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId  Int?
  workout    Workout?  @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  title      String
  note       String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  exercises SessionExercise[]
}

model SessionExercise {
  id    Int     @id @default(autoincrement())
  order Int     @default(0)
  note  String?

  sessionId         Int
  session           WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId        Int
  exercise          Exercise         @relation(fields: [exerciseId], references: [id])
  // the planned exercise it came from, to show the targets while logging
  workoutExerciseId Int?
  workoutExercise   WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id], onDelete: SetNull)

  sets LoggedSet[]
}

model LoggedSet {
  id        Int      @id @default(autoincrement())
  order     Int
  reps      Int
  weight    Float
  note      String?
  createdAt DateTime @default(now())

  sessionExerciseId Int
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
}

// Schema for a Revoked Token
model RevokedToken {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  createdAt DateTime @default(now())
}

// Enumeration for the different roles of a user
enum Role {
  USER
  ADMIN
}
